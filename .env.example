# SeekAuth configuration example
# Copy to .env and adjust as needed. Every setting can be overridden by an
# environment variable (prefix SEEK_).

# ── Service ──
# 127.0.0.1 = this machine only (safest)
# 0.0.0.0   = listen on every interface, so other devices on the LAN can reach it
#            (needs an inbound firewall rule; see "LAN access" in README)
SEEK_HOST=127.0.0.1
SEEK_PORT=18080
# Cap on in-flight requests, so hostile traffic cannot exhaust memory
SEEK_MAX_CONCURRENCY=64

# ── Logging ──
SEEK_LOG_LEVEL=INFO
# true emits JSON Lines (easy to ingest); false emits a human-readable format
SEEK_LOG_JSON=false
SEEK_LOG_MAX_BYTES=10485760
SEEK_LOG_BACKUP_COUNT=5
# Log request/response plaintext (tokens and cookies included) — troubleshooting only
SEEK_LOG_PAYLOADS=false

# ── Database ──
SEEK_DB_PATH=data/seek.db
SEEK_DB_POOL_SIZE=4
# AES session lifetime (seconds)
SEEK_SESSION_TTL=3600
# Interval between expired-row cleanups (seconds)
SEEK_SESSION_CLEANUP_INTERVAL=300

# ── Upstream NetEase API ──
SEEK_HTTP_TIMEOUT=30
SEEK_HTTP_MAX_CONNECTIONS=32
# g79 login-result cache lifetime (seconds) — avoids repeat PE auth tripping
# NetEase's 2100 rate limit
SEEK_G79_CACHE_TTL=1800

# ── Behaviour switches ──
# Auto-probe and pick the reachable line with the lowest latency
SEEK_AUTO_LINE_SELECT=true
# Force a rental-server address (debugging only), e.g. 1.2.3.4:14346
# SEEK_ADDRESS_OVERRIDE=
# Consecutive probes per line; all must succeed for the line to count as reachable.
# One RTT sample cannot separate lines that "get you into the server" from lines
# that "drop your session" (all four ISP lines measured 30-40ms per packet), so the
# default probes several times; 1 = single packet — faster, but nearly random.
SEEK_LINE_PROBE_ATTEMPTS=3

# ── Admin panel ──
# Panel mount path; leave empty to disable the panel entirely (no routes added)
SEEK_PANEL_PATH=/panel
# Panel bearer token. Empty = a random one is generated at each start (see the
# startup log): no long-lived secret in the config file, but re-login after a restart.
# SEEK_ADMIN_TOKEN=

# ── User centre ──
# Mount path for the player-facing pages: announcements / profile / my rental
# servers / my history / skins / server transfer / account settings. Login and
# registration are separate pages: <UC_PATH>/login and <UC_PATH>/register
SEEK_UC_PATH=/uc
# Announcement content file; kept out of the database — little content, rarely
# edited, and copy changes should never require a schema change.
SEEK_ANNOUNCEMENTS_PATH=data/announcements.json

# Whether token login to the user centre is still allowed.
#   true (the default) keeps local debugging and first-time onboarding easy;
#   a public release must set false — leave email + password as the only path.
SEEK_UC_ALLOW_TOKEN_LOGIN=true
# Email verification-code lifetime (seconds)
SEEK_UC_VERIFY_CODE_TTL=600

# ── Email delivery (user-centre registration) ──
# Unconfigured means console delivery: codes are only logged, never actually sent.
# Fine for local dev and self-testing, but a public release must configure SMTP
# or nobody gets the codes. Self-check: Admin panel → Config → Email → Send test.
SEEK_SMTP_HOST=
SEEK_SMTP_PORT=465
SEEK_SMTP_USER=
# The provider's authorization code / API key — not the mailbox login password
SEEK_SMTP_PASSWORD=
# Sender display name and address; falls back to SMTP_USER when empty
# SEEK_SMTP_FROM=
# true = SMTP_SSL (465), false = STARTTLS (587)
SEEK_SMTP_TLS=true

# Bot nickname; when empty a name like TestAxxxxx is generated
# SEEK_BOT_NAME=TestAgent5

# ── Key paths (relative to the project root) ──
SEEK_KEYS__SERVER_PRIVATE=keys/server_private.pem
SEEK_KEYS__CLIENT_PRIVATE=keys/client_private.pem
SEEK_KEYS__TOKEN_STORE=keys/fbtokens.json
